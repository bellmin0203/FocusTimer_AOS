<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for HaruFocus app.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices API 31+, use data_extraction_rules.xml instead.
-->
<full-backup-content>
    <!-- DataStore preferences backup -->
    <include domain="sharedpref" path="."/>
    <include domain="file" path="datastore/"/>
    <!-- Room database backup -->
    <include domain="database" path="."/>
</full-backup-content>