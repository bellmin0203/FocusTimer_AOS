<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_preview"
    android:gravity="center"
    android:orientation="vertical"
    tools:layout_width="180dp"
    tools:layout_height="180dp"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/widget_title"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="25:00"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:textSize="32sp" />

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_widget_circle"
        android:backgroundTint="@color/widget_primary"
        android:padding="12dp"
        android:src="@drawable/ic_widget_play"
        app:tint="@color/widget_on_primary" />

</LinearLayout>